<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.29.3" />
        <PackageReference Include="Grpc.Core.Api" Version="2.70.0" />
        <PackageReference Include="Grpc.Tools" Version="2.70.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protos\v1\wallet_enums.proto" GrpcServices="None" />
        <Protobuf Include="Protos\v1\messages\*.proto" GrpcServices="None" />
        <Protobuf Include="Protos\v1\wallet_grpc.proto" GrpcServices="Both" />
    </ItemGroup>

</Project>
