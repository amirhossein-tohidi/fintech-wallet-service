{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=FintechWalletDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "Topic": "wallet.domain-events",
    "ClientId": "wallet-worker-dev"
  },
  "Redis": {
    "Enabled": false,
    "Configuration": "localhost:6379",
    "InstanceName": "wallet:dev:"
  },
  "OutboxProcessor": {
    "Enabled": true,
    "BatchSize": 20,
    "PollingIntervalSeconds": 5,
    "LockSeconds": 60,
    "MaxRetryCount": 10,
    "DeadLetterBatchSize": 5,
    "DeadLetterPollingIntervalSeconds": 60
  },
  "InboxProcessor": {
    "Enabled": false,
    "BatchSize": 20,
    "PollingIntervalSeconds": 10,
    "LockSeconds": 60,
    "MaxRetryCount": 10,
    "DeadLetterBatchSize": 5,
    "DeadLetterPollingIntervalSeconds": 120
  },
  "ReservationExpiry": {
    "Enabled": true,
    "BatchSize": 20,
    "PollingIntervalSeconds": 30
  },
  "CircuitBreaker": {
    "FailureThreshold": 3,
    "BreakDurationSeconds": 15
  }
}
