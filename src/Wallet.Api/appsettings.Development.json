{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=FintechWalletDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "Topic": "wallet.domain-events",
    "ClientId": "wallet-service-dev",
    "ClusterName": "wallet-kafka-dev",
    "ProducerName": "wallet-events-producer",
    "ConsumerName": "wallet-events-inbox-consumer",
    "ConsumerGroupId": "wallet-inbox-dev"
  },
  "Redis": {
    "Enabled": false,
    "Configuration": "localhost:6379",
    "InstanceName": "wallet:dev:"
  },
  "CircuitBreaker": {
    "FailureThreshold": 3,
    "BreakDurationSeconds": 15
  },
  "Kestrel": {
    "Http2": {
      "AllowUnencryptedTraffic": true
    },
    "Endpoints": {
      "Http2Only": {
        "Url": "http://localhost:5001",
        "Protocols": "Http2"
      },
      "Http1AndHttp2": {
        "Url": "http://localhost:5000",
        "Protocols": "Http1"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
